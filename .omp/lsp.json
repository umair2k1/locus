{
  "servers": {
    "kotlin-lsp": {
      "command": "kotlin-lsp",
      "args": ["--stdio"],
      "fileTypes": [".kt", ".kts"],
      "rootMarkers": ["build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts"]
    },
    "clangd": {
      "command": "clangd",
      "args": ["--background-index", "--clang-tidy"],
      "fileTypes": [".c", ".cc", ".cpp", ".cxx", ".h", ".hh", ".hpp", ".hxx"],
      "rootMarkers": ["CMakeLists.txt", "compile_commands.json", ".clangd", ".git"]
    }
  }
}
